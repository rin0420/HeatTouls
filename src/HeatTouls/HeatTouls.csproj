<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HeatTouls</RootNamespace>
    <AssemblyName>HeatTouls</AssemblyName>
    <Product>HeatTouls</Product>
    <!-- ベータ。ファイルバージョンは数値しか持てないので、-beta は InformationalVersion 側に置く。 -->
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-beta</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HeatTouls.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- WinUI 3。パッケージ化せず(WindowsPackageType=None)、Windows App SDK の
         ランタイムも同梱するので、利用者は何も入れずに exe を起動できる。 -->
    <UseWinUI>true</UseWinUI>
    <!-- MSIX 自体は作らないが、XAML の .xbf と resources.pri を発行物へ運ぶのに
         このツーリングの target が要る。false にすると起動直後に落ちる。 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- CLI 引数を自前で捌くため、XAML が生成する Main は使わない (Program.cs) -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\HeatTouls.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
